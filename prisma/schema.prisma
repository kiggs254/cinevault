generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DownloadStatus {
  QUEUED
  SEARCHING
  DOWNLOADING
  UPLOADING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

enum MediaKind {
  MOVIE
  TV
  MUSIC
  SOFTWARE
  OTHER
}

/// One row per download the app tracks, from search through S3 upload.
model Download {
  id              String         @id @default(cuid())
  title           String // cleaned, human-friendly title
  releaseName     String // original torrent/release name
  kind            MediaKind      @default(OTHER)
  year            Int?
  season          Int?
  episode         Int?
  query           String? // the natural-language request that started it
  indexer         String?
  infoHash        String?
  magnet          String?        @db.Text
  status          DownloadStatus @default(QUEUED)
  progress        Float          @default(0) // 0..100
  sizeBytes       BigInt         @default(0)
  downloadedBytes BigInt         @default(0)
  dlSpeed         Int            @default(0) // bytes/sec
  upSpeed         Int            @default(0) // bytes/sec
  seeders         Int?
  etaSeconds      Int?
  s3Bucket        String?
  s3Key           String?
  s3Prefix        String?
  posterUrl       String?
  overview        String?        @db.Text
  metadata        Json?
  error           String?        @db.Text
  qbitHash        String? // torrent hash inside qBittorrent
  tmdbId          Int? // links a release to its TMDB title (for follows + retention)
  watchedAt       DateTime? // set when Jellyfin reports the media as played
  s3DeletedAt     DateTime? // set when retention removed the file from S3
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  userId          String? // requesting member (null = legacy/admin-owned)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([tmdbId])
  @@index([userId])
}

/// Single-row app configuration. Secrets are AES-256-GCM encrypted at rest.
model AppConfig {
  id        String   @id @default("singleton")
  secrets   Json? // { moonshotApiKey, mimoApiKey, qbitPassword, prowlarrApiKey, s3SecretAccessKey, tmdbApiKey } — each value encrypted
  settings  Json? // non-secret preferences + endpoints
  updatedAt DateTime @updatedAt
}

/// A community member. Portal login + an auto-provisioned Jellyfin account share
/// the same username/password. Registration is admin-approved.
model User {
  id                String    @id @default(cuid())
  username          String    @unique // portal login + Jellyfin username
  passwordHash      String // scrypt: "scrypt$<salt>$<hash>"
  pendingSecret     String? // AES-encrypted chosen password, kept only until Jellyfin is provisioned, then nulled
  role              String    @default("member") // member | admin
  status            String    @default("pending") // pending | active | denied | suspended
  jellyfinUserId    String? // set when the Jellyfin account is provisioned
  telegramChatId    String?   @unique // bound via bot /start link_<token>
  telegramLinkToken String?   @unique // one-time token for the Telegram deep-link
  notifyTelegram    Boolean   @default(true)
  statusToken       String    @unique @default(cuid()) // opaque token for the public /welcome status poll
  createdAt         DateTime  @default(now())
  approvedAt        DateTime?

  downloads       Download[]
  follows         FollowedShow[]
  wanted          WantedMovie[]
  recommendations Recommendation[]
  chats           ChatSession[]

  @@index([status])
}

/// A persisted assistant conversation. `items` holds the ordered chat items
/// (messages, option lists, actions) as JSON so the UI restores exactly.
model ChatSession {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  items     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([userId])
}

enum WatchType {
  SEARCH
  RSS
}

/// A tracked, auto-refreshed source: a saved indexer query or an RSS/Atom feed
/// from a LAWFUL source. The scheduler re-runs it and (optionally) auto-grabs
/// new matches.
model Watch {
  id         String    @id @default(cuid())
  type       WatchType @default(SEARCH)
  label      String
  query      String? // for SEARCH watches
  feedUrl    String? // for RSS watches
  kind       MediaKind @default(OTHER)
  quality    String    @default("any")
  minSeeders Int       @default(1)
  autoGrab   Boolean   @default(true)
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// A discovered release (from a watch scan or discovery search). Surfaced in the
/// "What's New" feed and optionally auto-grabbed when it matches the profile.
model FeedItem {
  id          String    @id @default(cuid())
  watchId     String?
  dedupeKey   String    @unique
  title       String
  source      String?
  link        String?
  magnet      String?   @db.Text
  infoHash    String?
  size        BigInt    @default(0)
  seeders     Int?
  kind        MediaKind @default(OTHER)
  matchScore  Int       @default(0)
  status      String    @default("new") // new | grabbed | dismissed
  publishDate DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

/// A TV show the user follows. The scheduler resolves its TMDB episode list and
/// auto-downloads aired episodes not yet in the library, from lawful indexers.
model FollowedShow {
  id            String    @id @default(cuid())
  tmdbId        Int
  title         String
  year          Int?
  posterUrl     String?
  overview      String?   @db.Text
  status        String? // TMDB series status: "Returning Series" | "Ended" | ...
  autoDownload  Boolean   @default(true)
  quality       String    @default("any")
  source        String    @default("manual") // manual | jellyfin | reco
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, tmdbId])
  @@index([autoDownload])
  @@index([userId])
}

/** A subscribed upcoming/unavailable movie: auto-download once a real (non-cam) release appears. */
model WantedMovie {
  id            String    @id @default(cuid())
  tmdbId        Int
  title         String
  year          Int?
  posterUrl     String?
  overview      String?   @db.Text
  releaseDate   DateTime? // TMDB primary release date (informational)
  status        String    @default("waiting") // waiting | grabbed
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, tmdbId])
  @@index([status])
  @@index([userId])
}

/// A cached, personalized suggestion (a TMDB title, not a release). Surfaced in
/// the redesigned Discover feed; the user can add (download/follow) or dismiss.
model Recommendation {
  id        String   @id @default(cuid())
  tmdbId    Int
  mediaType String // "movie" | "tv"
  title     String
  year      Int?
  posterUrl String?
  overview  String?  @db.Text
  reason    String?  @db.Text // AI: "because you finished Dexter…"
  score     Int      @default(0)
  source    String? // similar:<id> | trending | genre:<id>
  status    String   @default("new") // new | dismissed | added
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, tmdbId, mediaType])
  @@index([status])
  @@index([score])
  @@index([userId])
}
