# ============================================================================
#  MovieHub environment
#  Copy to `.env` and fill in. On Coolify, set these as environment variables.
#
#  Generate the two secrets with:
#     openssl rand -hex 32
# ============================================================================

# --- Required security --------------------------------------------------------
AUTH_PASSWORD=change-me-to-a-strong-password   # admin login password
AUTH_SECRET=                                   # openssl rand -hex 32 (session signing)
ENCRYPTION_KEY=                                # openssl rand -hex 32 (encrypts stored secrets)

# Public URL the app is served from (used for cookies/links).
APP_URL=http://localhost:3000
# Public trackers appended to every new torrent (helps find seeders). Leave unset
# for the built-in list; provide your own newline/comma-separated list to override;
# set to "none" to disable.
# EXTRA_TRACKERS=

# --- Datastores (defaults match docker-compose service names) -----------------
# These are injected by docker-compose; only override for external DB/redis.
# DATABASE_URL=postgresql://moviehub:moviehub@postgres:5432/moviehub
# REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=moviehub

# --- Torrent engine + indexers (compose sets URLs to internal hostnames) ------
# QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=            # from `docker compose logs qbittorrent` on first run
# PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=               # Prowlarr → Settings → General → API Key

# --- AI providers (OpenAI-compatible) — can also be set in the Settings UI ----
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.5
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# --- S3-compatible storage (Contabo) — can also be set in the Settings UI -----
S3_ENDPOINT=https://eu2.contabostorage.com
S3_REGION=default
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=                 # optional CDN/public base for library links

# --- Recommendations metadata (TMDB) — REQUIRED for Discover recommendations ---
TMDB_API_KEY=                   # posters, synopsis, recommendations, episode air dates (themoviedb.org — v3 key or v4 read token)

# --- Jellyfin (watch history → taste, auto-follow, retention) — Settings UI too -
JELLYFIN_URL=                   # e.g. http://jellyfin:8096 (internal) or https://your-jellyfin
JELLYFIN_API_KEY=               # Jellyfin → Dashboard → API Keys
JELLYFIN_USER_ID=               # optional; first user used if blank

# --- Telegram bot (agent chat + notifications) — can also set in Settings UI ---
TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_CHAT_ID=               # auto-set on first message to the bot

# --- Optional -----------------------------------------------------------------
DELETE_AFTER_UPLOAD=true        # remove local files + torrent after S3 upload
DOWNLOAD_CONCURRENCY=6          # max simultaneous download+upload jobs in the worker
GRAB_CONCURRENCY=4             # max simultaneous searches/grabs (separate pool from downloads)
                                # (shared with scans; also bounds concurrent S3 uploads).
                                # Keep qBittorrent's "Max active downloads" >= this value.
FLARESOLVERR_LOG_LEVEL=info     # FlareSolverr verbosity: info | debug
TZ=UTC

# --- Host port mappings (optional) --------------------------------------------
WEB_PORT=3000
QBIT_PORT=8080
PROWLARR_PORT=9696
